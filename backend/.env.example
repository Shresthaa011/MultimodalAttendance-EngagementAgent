# ==============================================================================
# Multimodal Attendance & Engagement Agent - Environment Configuration
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# LLM Agent Configuration (Groq API)
# Obtain an API key from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Database Configuration (SQLite default for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./attendance_engagement.db

# Multimodal Agent Thresholds & Tuning
FACE_CONFIDENCE_THRESHOLD=0.5
ENGAGEMENT_ATTENTION_WINDOW_SEC=5
AUDIO_NOISE_THRESHOLD_DB=30.0
HEAD_POSE_PITCH_THRESHOLD=20.0
HEAD_POSE_YAW_THRESHOLD=25.0
EYE_ASPECT_RATIO_BLINK_THRESHOLD=0.20
